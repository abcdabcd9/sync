# ============================================================
# Sync App — environment variable template
# ============================================================
# How to use:
#   1. Copy this file to .env
#        cp .env.example .env
#   2. Replace the placeholder values below with your own
#   3. Restart the dev server (npx expo start --clear)
#
# Important: .env is ignored by .gitignore. Never commit it.
# ============================================================


# ------------------------------------------------------------
# Supabase (required)
# ------------------------------------------------------------
# Where to get them:
#   1. Open https://supabase.com/dashboard
#   2. Pick your project → Settings → API
#   3. Copy the "Project URL" and the "anon public" key
#
# Notes:
#   - The anon key is public; security is enforced by database RLS policies
#   - Never put a service_role key here (it bypasses all RLS)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here


# ------------------------------------------------------------
# Voice-to-text (Groq) — SERVER-SIDE ONLY, do NOT put it here
# ------------------------------------------------------------
# The Groq API key is no longer a client variable. Voice-to-text now goes
# through the authenticated `transcribe-audio` Edge Function, which reads the
# key from Supabase secrets on the server:
#
#   npx supabase secrets set GROQ_API_KEY=<your-groq-key>
#   npx supabase functions deploy transcribe-audio
#
# Never add EXPO_PUBLIC_GROQ_API_KEY here: EXPO_PUBLIC_* variables are bundled
# into the app binary and are publicly extractable.
