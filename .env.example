# ============================================================
# Sync App — environment variable template
# ============================================================
# How to use:
#   1. Copy this file to .env
#        cp .env.example .env
#   2. Replace the placeholder values below with your own
#   3. Restart the dev server (npx expo start --clear)
#
# Important: .env is ignored by .gitignore. Never commit it.
# ============================================================


# ------------------------------------------------------------
# Supabase (required)
# ------------------------------------------------------------
# Where to get them:
#   1. Open https://supabase.com/dashboard
#   2. Pick your project → Settings → API
#   3. Copy the "Project URL" and the "anon public" key
#
# Notes:
#   - The anon key is public; security is enforced by database RLS policies
#   - Never put a service_role key here (it bypasses all RLS)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here


# ------------------------------------------------------------
# Groq (optional — only needed for voice-to-text)
# ------------------------------------------------------------
# Where to get it:
#   1. Open https://console.groq.com/keys
#   2. Create an API key
#
# Security warning:
#   Variables with the EXPO_PUBLIC_ prefix get bundled into the app binary.
#   Anyone who decompiles the APK/IPA can extract them.
#   Recommendations:
#     a) Set a usage cap on this key
#     b) Or proxy the call through your own backend / Edge Function
#   If you leave this empty, voice-to-text shows "not configured"; everything else still works.
EXPO_PUBLIC_GROQ_API_KEY=your-groq-api-key-here
